# Neon API
NEON_API_URL="https://console.neon.tech/api/v2"
NEON_API_KEY=

# Project ID corresponding to the Neon project that contains the development database branches
# Must be within the scope of `NEON_API_KEY`
NEON_PROJECT_ID=



# --- Optional ---

# # GitHub Personal Access Token that must have permissions to read organization members
# # Used to check if a GitHub username is a member of the organization
# GITHUB_TOKEN=

# # Unpooled connection URL for the production database
# # Used as the source for dumping the production database
# PRODUCTION_DATABASE_URL=
